sub new ($$) {
  my ($class, $conf) = @_;

  my $self = bless { conf => $conf }, $class;

  my $modulesdir = $conf->{'daemon.modules.dir'};
  my $logger = $conf->{logger};
  my %loadedmodules;
  my %scheduler;

  if (-d $modulesdir) {
    $logger->logmsg("Loading modules from $modulesdir");
```

