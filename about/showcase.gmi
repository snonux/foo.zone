Go from `queue/elementarypriority.go`:

```AUTO
func (q *ElementaryPriority[T]) DeleteMax() T {
	if q.Empty() {
		return 0
	}

	ind, max := q.max()
	for i := ind + 1; i < q.Size(); i++ {
		q.a[i-1] = q.a[i]
	}
	q.a = q.a[0 : len(q.a)-1]

	return max
}
```

