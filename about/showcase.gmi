func Slurp(what *string, path string) error {
	bytes, err := ioutil.ReadFile(path)
	if err != nil {
		return err
	} else {
		for _, byte := range bytes {
			if byte == 0 {
				*what += " "
			} else {
				*what += string(byte)
			}
		}
	}
	return nil
}
```

